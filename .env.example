IPA_USER=
IPA_PASS=
AAP_USER=
AAP_PASS=
AAP_URL=https://aap.example.com
# password set on the seeded perf-* LDAP users
PERF_PASS=
# optional, used by loadtest.py on the load node
LOKI_URL=http://loki.example.com:3100
IPA_URL=https://ipa.example.com/ipa
LDAP_URI=ldap://ipa.example.com:389
LDAP_BASE_DN=dc=example,dc=com

# seed_idm.py and run_matrix.sh: number of perf-user-NN concurrency pool users
PERF_POOL_SIZE=25

# run_matrix.sh - where things are
LOAD_NODE=user@loadgen.example.com
# extra options for every ssh and scp call, e.g. -F /path/to/ssh_config
SSH_OPTS=
# directory on the load node (relative to the home directory) holding loadtest.py and .env
LOAD_DIR=aap-perf
# Playwright container image on the load node
LOAD_IMAGE=aap-perf-pw
# 1 = copy loadtest.py to the load node before the run; 0 = only check that it is identical
PUSH_LOADTEST=0
# optional, empty = no Grafana annotations
GRAFANA_HOST=user@grafana.example.com
# command run on GRAFANA_HOST with the annotation text as its argument
GRAFANA_ANNOTATE='~/aap-perf-annotate.sh'
AAP_NAMESPACE=aap
AAP_KUBECONFIG=
# gateway pods: label selector, name filter applied to the result, container with the access log
GATEWAY_SELECTOR=app.kubernetes.io/component=gateway
GATEWAY_POD_REGEX=gateway
GATEWAY_CONTAINER=api

# run_matrix.sh - what to run
# sequence of <mappers>:<on|off>; for an A/B/A drift check use "1500:off 1500:on 1500:off"
CELLS="1:off 1:on 500:off 500:on 1500:off 1500:on"
# how often the whole sequence is run
REPEAT=1
# concurrency levels, one concurrent phase per level
RAMP="10"
# sequential logins per user in the steady phase
STEADY_ITER=20
# logins per pool user in each concurrent phase
CONC_ITER=4
# users of the first and steady phases
SINGLE_USERS=perf-match-few,perf-match-many,perf-nomatch,perf-ctl-150
# users that have never logged in (seed_idm.py cold); empty = no cold phase
COLD_USERS=
# cold users consumed per cell, and logins per cold user (the first one is the cold start)
COLD_PER_CELL=1
COLD_ITER=5
# pause before each sequential login, uniform between the two, in seconds
THINK_MIN=0.5
THINK_MAX=2.0
# seed of the think times, recorded in every record; empty = picked per run
THINK_SEED=
# abort = stop the run when a browser phase fails or writes no records; continue = carry on
ON_PHASE_FAIL=abort

# make_dashboard.py - Grafana datasource uids
GRAFANA_PROM_UID=
GRAFANA_LOKI_UID=loki
